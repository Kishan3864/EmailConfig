# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:../data/app.db"

# Single-user login
APP_PASSWORD="change-me-to-a-long-password"
# Random 32+ char string used to sign the session cookie
SESSION_SECRET="replace-with-random-string-at-least-32-chars"

# Mailbox secrets (host/port/user are set in the Settings page)
SMTP_PASSWORD=""
IMAP_PASSWORD=""          # leave empty to reuse SMTP_PASSWORD

# Any OpenAI-compatible endpoint key (base URL + model are set in Settings)
AI_API_KEY=""

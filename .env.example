# ---- Local development only (on Firebase these come from Secret Manager, see apphosting.yaml) ----

# Single-user login
APP_PASSWORD="change-me-to-a-long-password"
# Random 32+ char string used to sign the session cookie
SESSION_SECRET="replace-with-random-string-at-least-32-chars"

# Mailbox password (host/port/user are set in the Settings page)
SMTP_PASSWORD=""
IMAP_PASSWORD=""          # leave empty to reuse SMTP_PASSWORD

# Any OpenAI-compatible endpoint key (base URL + model are set in Settings)
AI_API_KEY=""

# Firebase / Firestore
FIREBASE_PROJECT_ID="brighton-web-ea63c"
FIRESTORE_DATABASE_ID="outreach"
# Service-account key file for local dev (Firebase console > Project settings > Service accounts > Generate key)
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

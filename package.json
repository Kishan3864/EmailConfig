{
  "name": "email-config",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate:settings": "tsx scripts/migrate-settings.ts",
    "deploy:rules": "firebase deploy --only firestore:outreach",
    "deploy:worker": "firebase deploy --only functions:outreach",
    "deploy:web": "firebase deploy --only apphosting"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.5.0",
    "imapflow": "^1.0.196",
    "mailparser": "^3.7.4",
    "next": "^15.5.4",
    "nodemailer": "^7.0.6",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "robots-parser": "^3.0.1",
    "tsx": "^4.20.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.10",
    "firebase-functions": "^6.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
